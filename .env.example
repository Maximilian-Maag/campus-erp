# Copy to .env and adjust. All values have sensible defaults in docker-compose.yml.
#
# Postgres (local development only - change this for anything reachable)
POSTGRES_PASSWORD=erp
POSTGRES_DB=campus_erp
POSTGRES_PORT=5433

# Backend / API
API_PORT=8080
ERP_TENANT=demo

# Frontend (nginx)
WEB_PORT=8081

# Image tags (override for a registry push, e.g. ghcr.io/maximilian-maag/campus-erp-backend)
IMAGE_BACKEND=campus-erp-backend:dev
IMAGE_FRONTEND=campus-erp-frontend:dev
