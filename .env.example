# Copy to .env and adjust. All values have sensible defaults in docker-compose.yml.
#
# Postgres (local development only - change this for anything reachable)
POSTGRES_PASSWORD=erp
POSTGRES_DB=campus_erp
POSTGRES_PORT=5433

# Backend / API
API_PORT=8080
ERP_TENANT=demo

# Frontend (nginx)
WEB_PORT=8081

# Image tags (override for a registry push; `make docker-publish` uses
# docker.io/maximilianmaag/campus-erp-{backend,frontend})
IMAGE_BACKEND=campus-erp-backend:dev
IMAGE_FRONTEND=campus-erp-frontend:dev

# Sign-in (ADR-0003). The api refuses to start without an issuer, and the stack ships a
# Keycloak realm for it (deploy/local/keycloak), so these are `make run`'s defaults — the
# values live in docker-compose.yml. Uncomment to point the stack at another IdP: the issuer
# is the address the *browser* uses (the token's `iss`), the keys are fetched inside the
# compose network. Overriding only one half is how you get 401s.
# ERP_OIDC_ISSUER=http://localhost:9080/realms/campus-erp
# ERP_OIDC_CLIENT_ID=campus-erp
# ERP_OIDC_AUDIENCE=campus-erp
# ERP_OIDC_JWKS_URL=http://keycloak:8080/realms/campus-erp/protocol/openid-connect/certs
# KEYCLOAK_PORT=9080
